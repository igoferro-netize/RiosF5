# ⚙️ Configuração de HTTPS para Produção
# Arquivo: backend/riosf5-backend/.env.production

# ============ MODO DEBUG ============
FLASK_ENV=production
FLASK_DEBUG=False

# ============ SEGURANÇA ============
ENVIRONMENT=production

# JWT Secret - MUDAR PARA VALOR ÚNICO E FORTE!
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=<SEU_JWT_SECRET_UNICO_AQUI>

# ============ DATABASE ============
# PostgreSQL em produção
DATABASE_URL=postgresql://username:password@db.example.com:5432/riosf5_prod

# ============ CACHE/SESSIONS (Redis) ============
REDIS_URL=redis://:password@redis.example.com:6379/0
REDIS_HOST=redis.example.com
REDIS_PORT=6379

# ============ HTTPS/TLS ============
# Ativar HTTPS obrigatório
ENFORCE_HTTPS=True
HSTS_ENABLED=True
HSTS_MAX_AGE=31536000  # 1 ano
HSTS_PRELOAD=True

# SSL Certificate (for gunicorn with SSL)
# Gerar com: certbot certonly --standalone -d api.example.com
SSL_CERT_FILE=/etc/ssl/certs/api.example.com.crt
SSL_KEY_FILE=/etc/ssl/private/api.example.com.key

# ============ CORS ============
CORS_ORIGINS=https://app.example.com,https://example.com
FRONTEND_URL=https://app.example.com

# ============ EMAIL ============
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=<APP_PASSWORD_AQUI>
MAIL_DEFAULT_SENDER=noreply@example.com

# ============ UPLOAD ============
UPLOAD_FOLDER=/var/riosf5/uploads
MAX_FILE_SIZE=100
MAX_CONTENT_LENGTH=104857600  # 100 MB

# ============ MONITORAMENTO ============
SENTRY_ENABLED=True
SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456
SENTRY_TRACES_SAMPLE_RATE=0.1

# Alertas
ALERT_ON_FAILED_LOGINS=True
FAILED_LOGIN_THRESHOLD=5
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL=admin@example.com

# ============ BACKUP ============
BACKUP_DIR=/var/riosf5/backups
RETENTION_DAYS=30
S3_BUCKET=riosf5-backups-prod
AWS_REGION=us-east-1

# ============ LOGGING ============
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=True
AUDIT_LOG_FILE=/var/log/riosf5/audit.log

# ============ PERFORMANCE ============
WORKERS=4
THREADS=2
WORKER_CLASS=sync  # ou 'gevent' para async

# ============ RATE LIMITING ============
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_API=30 per minute
RATE_LIMIT_PASSWORD_RESET=3 per hour

# ============ PASSWORD POLICY ============
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL=True

# ============ MULTI-TENANT ============
ENABLE_TENANT_ISOLATION=True
ENFORCE_TENANT_BOUNDARIES=True

# ============ INITIAL ADMIN (apenas primeira inicialização) ============
# Mude ou remova após criar o usuário inicial
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=<MUDAR_APOS_PRIMEIRO_LOGIN>

